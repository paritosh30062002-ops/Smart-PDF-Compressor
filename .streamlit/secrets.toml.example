# Copy this file's contents into Streamlit Community Cloud -> your app -> Settings -> Secrets.
# For local testing, save it as .streamlit/secrets.toml (that file is git-ignored - never commit it).

[app]
admin_emails = ["you@gmail.com"]           # who can open the Admin page
support_contact = "you@gmail.com"          # shown after a user requests a Pro plan
allow_folder_export = false                # keep false on the public site

[supabase]
url = "https://YOUR-PROJECT.supabase.co"
anon_key = "YOUR-ANON-PUBLIC-KEY"          # Supabase -> Project Settings -> API keys
service_key = "YOUR-SERVICE-ROLE-KEY"      # secret! server only

[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"   # local: http://localhost:8501/oauth2callback
cookie_secret = "PASTE-A-LONG-RANDOM-STRING"                       # e.g. python -c "import secrets;print(secrets.token_hex(32))"

[auth.google]
client_id = "YOUR-GOOGLE-CLIENT-ID.apps.googleusercontent.com"
client_secret = "YOUR-GOOGLE-CLIENT-SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
